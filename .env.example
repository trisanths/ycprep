# Recommended for your Azure OpenAI resource from the Model deployments screen:
AZURE_AI_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/openai/responses
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional fallback when browser speech recognition does not produce a transcript.
# Deploy a Whisper or transcription model in Azure, then set its deployment name here.
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=
AZURE_OPENAI_TRANSCRIPTION_API_VERSION=2024-06-01

# Azure AI Foundry model inference alternative
# Example endpoint: https://<resource>.services.ai.azure.com/models
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=
AZURE_AI_API_VERSION=2024-05-01-preview

# Other valid deployment names from your screenshot:
# AZURE_OPENAI_DEPLOYMENT=model-router
# AZURE_AI_MODEL=DeepSeek-V4-Flash
# AZURE_AI_MODEL=Kimi-K2.6
